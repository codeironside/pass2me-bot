NODE_ENV=development
PORT=8080
DATABASE_PATH=./data/pas2me.sqlite

# Public URL for invite links & payment callbacks
BOT_PUBLIC_URL=http://localhost:8080
WEBHOOK_SECRET=change-me-webhook-secret
JWT_INVITE_SECRET=change-me-invite-secret

# Baileys (in-process WhatsApp Web multi-device)
WA_AUTH_DIR=./data/baileys_auth
WA_INTERACTIVE_MODE=text
WA_JITTER_MIN_MS=800
WA_JITTER_MAX_MS=2800

# WhatsApp Cloud API & Shared Credentials
WHATSAPP_PHONE_NUMBER_ID=1014522441749873
PAYSTACK_PUBLIC_KEY=pk_test_30d303b8f93fde06a436fef3bc925b54f05c4fb1
CLOUDINARY_CLOUD_NAME=ddkrpymbt
CLOUDINARY_API_KEY=2HS7C1zi-LrtqR-jImhuDqI7ZiA

# Cloudflare D1 Database REST API Credentials (Option B)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=46009d94-37b4-4536-bc7d-7ec37c389ef0
CLOUDFLARE_API_TOKEN=
# true = hosted D1 via REST. false = local wrangler sqlite (same DB as dashboard)
CLOUDFLARE_D1_REMOTE=false

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=pas2me-storage

# Monnify (wallet VAs / checkout) — sandbox default
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_DISBURSEMENT_SOURCE_ACCOUNT=

# Cabme dispatch
CABME_BASE_URL=
CABME_API_KEY=
CABME_PAYMENT_METHOD_ID=
CABME_PARCEL_CATEGORY_ID=
CABME_REGISTER_URL=

# Flutterwave (airtime / bills)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# SMS OTP (Termii by default)
SMS_PROVIDER=termii
SMS_BASE_URL=https://api.ng.termii.com
SMS_API_KEY=
SMS_SENDER_ID=Pas2me
SMS_OTP_TTL_SECONDS=300

# Platform fees (basis points = 1/100 of a percent; 100 = 1%)
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FLAT_KOBO=0
YEARLY_DISCOUNT_BPS=1667

# Rate limiting
OUTBOUND_RATE_LIMIT_PER_MINUTE=30
