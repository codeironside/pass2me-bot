{
  "name": "pas2me",
  "version": "1.0.0",
  "description": "Pas2me WhatsApp bot (Baileys) — Express + TypeScript",
  "license": "ISC",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "auth:reset": "node -e \"fs.rmSync('./data/baileys_auth', { recursive: true, force: true }); console.log('Baileys session reset. Run npm run dev to scan new QR code.');\"",
    "migrate": "tsx src/db/migrate.ts",
    "seed:developer": "tsx scripts/seed-developer.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "nanoid": "^3.3.11",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
